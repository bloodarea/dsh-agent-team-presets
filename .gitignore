node_modules/
*.tsbuildinfo
.DS_Store
*.log

# Internal working material: outdated release notes, acceptance/verification
# reports, evidence, audits and development guides live in /docs/internal and
# are never published. Public usage guidance belongs in the READMEs; publish a
# reviewed, sanitized copy elsewhere when needed.
/docs/internal/
/docs/**/*.md
/docs/**/*.html
# ...except the public beginner guide, which ships with the package.
!/docs/guide/
!/docs/guide/*.md
/CHANGELOG.md
/contrib/awesome-dsh-plugin/PR.md

# Tool artifacts: never published.
.brooks-lint-history.json
__pycache__/
*.pyc
output/
