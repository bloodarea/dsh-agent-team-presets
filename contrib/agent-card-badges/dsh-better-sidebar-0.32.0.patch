diff --git a/src/client/agent-card-badges.tsx b/src/client/agent-card-badges.tsx
new file mode 100644
index 0000000..18c319d
--- /dev/null
+++ b/src/client/agent-card-badges.tsx
@@ -0,0 +1,90 @@
+import { Component, useSyncExternalStore, type ComponentType, type ReactNode } from 'react'
+
+export type AgentCardBadgeComponent = ComponentType<{ sessionId: string }>
+
+export interface AgentCardBadgesService {
+  readonly version: 1
+  register(entry: { id: string; Component: AgentCardBadgeComponent }): () => void
+}
+
+type Entry = { id: string; Component: AgentCardBadgeComponent; revision: number }
+
+class BadgeBoundary extends Component<{ children: ReactNode }, { failed: boolean }> {
+  state = { failed: false }
+
+  static getDerivedStateFromError(): { failed: boolean } {
+    return { failed: true }
+  }
+
+  componentDidCatch(error: unknown): void {
+    console.error('[agent-card-badges] contribution failed', error)
+  }
+
+  render(): ReactNode {
+    return this.state.failed ? null : this.props.children
+  }
+}
+
+export function createAgentCardBadges(): {
+  service: AgentCardBadgesService
+  Badges: AgentCardBadgeComponent
+  dispose: () => void
+} {
+  let entries: readonly Entry[] = []
+  let revision = 0
+  let disposed = false
+  const listeners = new Set<() => void>()
+  const notify = (): void => { for (const listener of [...listeners]) listener() }
+  const getSnapshot = (): readonly Entry[] => entries
+  const subscribe = (listener: () => void): (() => void) => {
+    if (disposed) return () => {}
+    listeners.add(listener)
+    return () => { listeners.delete(listener) }
+  }
+  const service: AgentCardBadgesService = {
+    version: 1,
+    register(entry) {
+      if (disposed) throw new Error('Agent card badges service is disposed')
+      if (entry.id.trim() === '') throw new Error('Agent card badge id must not be empty')
+      if (entries.some(current => current.id === entry.id)) {
+        throw new Error(`Agent card badge already registered: ${entry.id}`)
+      }
+      const registered = { id: entry.id, Component: entry.Component, revision: ++revision }
+      entries = [...entries, registered]
+      notify()
+      return () => {
+        if (!entries.includes(registered)) return
+        entries = entries.filter(current => current !== registered)
+        notify()
+      }
+    },
+  }
+  function Badges({ sessionId }: { sessionId: string }): ReactNode {
+    const snapshot = useSyncExternalStore(subscribe, getSnapshot, getSnapshot)
+    if (snapshot.length === 0) return null
+    return (
+      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 3, flex: '0 1 auto', minWidth: 0, maxWidth: 90, height: '1em', maxHeight: 16, overflow: 'hidden', whiteSpace: 'nowrap' }}>
+        {snapshot.map(entry => (
+          <BadgeBoundary key={`${entry.id}:${entry.revision}:${sessionId}`}>
+            <entry.Component sessionId={sessionId} />
+          </BadgeBoundary>
+        ))}
+      </span>
+    )
+  }
+  return {
+    service,
+    Badges,
+    dispose() {
+      if (disposed) return
+      disposed = true
+      entries = []
+      notify()
+      listeners.clear()
+    },
+  }
+}
+
+export function agentCardSessionId(node: { id: string; childAddress?: { childSessionId: string } }): string | undefined {
+  return node.childAddress?.childSessionId ?? (node.id.startsWith('wfmember:') ? undefined : node.id)
+}
